{
  "name": "updraft",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "postinstall": "node scripts/copy-cesium.mjs",
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "sync": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync",
    "check": "npm run sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "test:ui": "playwright test",
    "bench": "svelte-kit sync && vitest bench --run --silent=false",
    "bench:ui": "PERF=1 playwright test perf --reporter=line",
    "lint": "npm run sync && prettier --check . && eslint .",
    "format": "npm run sync && prettier --write . && eslint --fix .",
    "docs:services": "node scripts/gen-service-docs.mjs src/lib/plugins/api.d.ts docs/services"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@playwright/test": "^1.65.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.80.0",
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "^1.147.0",
    "fit-file-parser": "^6.2.10",
    "idb": "^8.0.4",
    "igc-parser": "^2.0.0",
    "igc-xc-score": "^1.8.0",
    "maplibre-gl": "^6.19.0",
    "mediabunny": "1.66.2",
    "pbf": "^5.2.0",
    "pocketbase": "0.29.0",
    "uplot": "^1.6.32"
  }
}
