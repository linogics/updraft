{
  "name": "updraft",
  "short_name": "updraft",
  "description": "Play back, log and plan paragliding and hang gliding flights in your browser.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a090d",
  "theme_color": "#0a090d",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/octet-stream": [".igc", ".gpx", ".kml", ".fit", ".trk", ".geojson", ".json"]
      }
    }
  ]
}
